APP_NAME=ORQ
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.orq.mhmdfwzi.com

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=orq
DB_USERNAME=orq_user
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
FILESYSTEM_DISK=public
QUEUE_CONNECTION=sync
CACHE_STORE=database

# Storefront (Next.js) — used for CORS and on-demand revalidation
FRONTEND_URL=https://orq.mhmdfwzi.com
REVALIDATE_SECRET=

# Mail (optional): leave "log" until real ORQ SMTP credentials exist
MAIL_MAILER=log
MAIL_FROM_ADDRESS="orders@orq.mhmdfwzi.com"
MAIL_FROM_NAME="${APP_NAME}"

# WhatsApp admin alerts (optional, UltraMsg): leave empty to disable
ULTRAMSG_INSTANCE=
ULTRAMSG_TOKEN=
ADMIN_WHATSAPP=
